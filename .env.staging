# ============================================================
# 预演示环境（Staging）
# 构建：vite build --mode staging
# ============================================================

VITE_APP_ENV=staging

# 构建产物直接请求 staging API（不走 proxy，需支持 CORS 或同域部署）
VITE_API_BASE_URL=https://staging-api.nexusstack.com/api

API_TARGET=https://staging-api.nexusstack.com
