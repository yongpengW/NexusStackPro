# ============================================================
# 基础配置 — 所有环境共用，各环境 .env.[mode] 中的同名变量会覆盖此值
# ============================================================

# 应用名称
VITE_APP_TITLE=Nexus Stack

# 当前环境标识（本文件作为本地开发默认值）
VITE_APP_ENV=development

# API 请求基础路径（dev server 有 proxy 时统一用 /api，代理透明转发）
VITE_API_BASE_URL=/api

# ----------------------------------------------------------------
# Dev server proxy 目标（无 VITE_ 前缀 → 不暴露给客户端代码）
# vite.config.ts 通过 loadEnv 读取，用于配置 server.proxy
# ----------------------------------------------------------------
API_TARGET=http://localhost:5244

VITE_ICONFONT_URL=https://at.alicdn.com/t/c/font_5134454_u7yfdfyo06.js